[jnt:htmlFilteringReports] > nt:base
 + * (jnt:htmlFilteringReport)

[jnt:htmlFilteringReport] > nt:base
 - status (string)
 - workspace (string)
 - started (date)
 - finished (date)
 - maxItems (long)
 - itemCount (long)
 - items (string)
